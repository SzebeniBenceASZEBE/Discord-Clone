# Copy to .env and adjust. .env is gitignored.

# 'development' (default) or 'production'. In production the session cookie is
# marked Secure (HTTPS-only), which is what you want behind Caddy's TLS.
NODE_ENV=development

# HTTP port the API + WebSocket server listens on (behind Caddy).
PORT=3001

# Public URL of the web app, used to build invite links (added in lesson 2).
APP_URL=http://localhost:5173

# Where SQLite and encrypted file blobs live on the home server's disk.
DATA_DIR=./data

# Master key for at-rest encryption of message/file blobs (server-managed keys
# model). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# This is the single most security-critical secret on the home box. Never commit it.
MASTER_KEY=

# LiveKit (voice/screen). The defaults below match `livekit-server --dev`, so
# you don't need to set these for local development. In production point URL at
# the VPS (wss://sfu.your-name.duckdns.org) and use a real random key/secret
# that you ALSO put in the VPS's livekit.yaml.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
