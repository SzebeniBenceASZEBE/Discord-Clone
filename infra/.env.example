# Copy to infra/.env on the VPS and fill in. This file feeds BOTH docker-compose
# (variable substitution) and the backend container (env_file). Never commit .env.

# --- Public hostnames (Cloudflare DNS-only / grey cloud A records → VPS IP) ---
CHAT_DOMAIN=chat.yourdomain.com
SFU_DOMAIN=sfu.yourdomain.com

# --- App ---
NODE_ENV=production
PORT=3001
APP_URL=https://chat.yourdomain.com

# --- At-rest encryption key (32 bytes, base64). Generate ONCE and keep it safe:
#   openssl rand -base64 32
# Losing it makes every stored message and file permanently unreadable.
MASTER_KEY=

# --- LiveKit. The key is a short id; the secret is random. Both are shared with
# the LiveKit server automatically (via LIVEKIT_KEYS in docker-compose).
#   LIVEKIT_API_KEY: e.g. APIghjk1234
#   LIVEKIT_API_SECRET: openssl rand -base64 32
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://sfu.yourdomain.com
