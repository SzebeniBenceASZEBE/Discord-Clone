# Home server reverse proxy. Caddy terminates TLS (auto-cert via the DuckDNS
# name) and routes the app domain to the web build + the Node backend.
#
# Replace app.example.duckdns.org with your real DuckDNS hostname for the app.

app.example.duckdns.org {
	encode zstd gzip

	# API + WebSocket -> Node backend.
	@api path /api/* /ws
	reverse_proxy @api server:3001

	# Everything else -> the built static web app (served by the web container).
	reverse_proxy web:80
}
